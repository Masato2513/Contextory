<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- website 路线主 App：非 sandbox。
         若未来启用 Mac App Store 路线，需要重新设计正式 App Group 与数据迁移。
         注：codesign 的 entitlements 解析器对 XML-like token 敏感，本注释保持纯文字。 -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.io.github.masato2513.Contextory</string>
    </array>
</dict>
</plist>
